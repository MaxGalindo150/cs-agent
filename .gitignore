# Python virtual environment (managed by uv — never commit it)
.venv/

# Python caches / bytecode
__pycache__/
*.py[cod]

# Build / packaging artifacts (editable install metadata)
*.egg-info/
build/
dist/
# Vendored build of @cashea/cheo, committed on purpose (frontend/vendor/README.md).
!frontend/vendor/cheo-orb/dist/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
coverage.xml
htmlcov/

.traces/

# Secrets — never commit. Templates (.env.example) are committed.
.env
.env.local

# Note: uv.lock is intentionally NOT ignored (committed for reproducible
# installs).
