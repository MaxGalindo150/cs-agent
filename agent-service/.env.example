# Agent Service — local environment template.
# Copy to `.env` and fill in real values:  cp .env.example .env
#
# `.env` is git-ignored and is for LOCAL development only. In deployed
# environments (Cloud Run) these values come from the service config and
# Secret Manager — there is no .env file, and real env vars take precedence.

# --- App ---
ENVIRONMENT=dev                 # dev | staging | prod
DEBUG=false
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
# Apply pending Alembic migrations on startup. Handy locally; set to false in
# prod (Cloud Run) where migrations run in the deploy pipeline, not at boot.
RUN_MIGRATIONS_ON_STARTUP=true

# --- CORS ---
# Comma-separated allowlist. The browser widget calls this API cross-origin.
# Never use "*" together with credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Anthropic (LLM reasoning) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here            # required — keep secret
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_CHAT_FALLBACK_MODEL=claude-sonnet-4-6

# --- Embeddings (semantic memory) ---
# Voyage AI powers the semantic-memory embeddings (Anthropic has no embeddings
# API). Required — the service will not boot without it. Model/dims are optional.
VOYAGE_API_KEY=pa-your-voyage-key-here            # required — keep secret
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIMS=1024

# --- External systems ---
# BNPL backend the agent's tools query (the mock-server at the repo root).
BNPL_API_URL=http://localhost:3001

# --- Database (agent memory & sessions) ---
# Async SQLAlchemy URL (note the +asyncpg driver). Points at the compose
# Postgres as published on the host (5433); this service owns the `agent`
# schema within it. Running inside compose, the container overrides this with
# `postgres:5432`. Deployed environments override via Secret Manager.
# Same value is used by Alembic migrations (alembic/env.py).
AGENT_DATABASE_URL=postgresql+asyncpg://csa:csa@localhost:5433/customer_support

# --- Tracing (optional) ---
# Local JSONL trace + usage ledger dir (ephemeral in a container). Leave the
# OTel endpoint empty for stdout-only; point it at Phoenix (localhost:4317) or
# Langfuse to export spans.
TRACE_DIR=.traces
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Internal worker (consolidation) ---
# Shared secret for POST /internal/consolidate — not a route the frontend or
# chat endpoints ever call. Empty (the default) refuses every request; set it
# to something random locally to exercise the endpoint yourself.
INTERNAL_WORKER_TOKEN=
# Consolidate a user once they have this many unconsolidated exchanges (2
# messages each). Mirrors waku-agent's WAKU_CONSOLIDATE_EVERY default.
CONSOLIDATE_EVERY=6
# Max due users one sweep takes on (the rest wait for the next trigger) and
# how many of them run concurrently within a sweep.
CONSOLIDATE_BATCH_SIZE=50
CONSOLIDATE_CONCURRENCY=5
